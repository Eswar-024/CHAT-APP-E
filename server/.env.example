NODE_ENV=development
PORT=3001
CLIENT_ORIGIN=http://localhost:3000

# Server-only. Never put this file in the Vite app or commit real secrets.
#
# Supabase → Settings → Database → Connection string (URI).
# Prefer the session or transaction pooler URI (port 6543) if IPv6 direct
# connections fail from your network.
# Example:
# DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
DATABASE_SSL=true
# Use false only if the pooler certificate cannot be verified.
DATABASE_SSL_REJECT_UNAUTHORIZED=false

SESSION_COOKIE_NAME=sid
SESSION_TTL_DAYS=14
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
TRUST_PROXY=false
